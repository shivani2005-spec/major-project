# NoteWise AI Environment Configuration
# Add your Google Gemini API key below:
GEMINI_API_KEY=

# LLM Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Database Configuration
# Local MongoDB or MongoDB Atlas URI:
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=notewise

# JWT Authentication
JWT_SECRET=notewise-super-secret-jwt-key-2026-prod-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Backend Configuration
PORT=8000
HOST=127.0.0.1

# RAG & Chunking Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_CHUNKS=4
MAX_FILE_SIZE_MB=25
